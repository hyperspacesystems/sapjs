{
  "name": "@panphora/sapjs",
  "version": "0.11.1",
  "description": "A reactive HTML library where the DOM is the only state store. Structure-first, one write path, transient rebuild. An Alpine alternative built for self-saving HTML files.",
  "type": "module",
  "main": "src/sap.js",
  "exports": {
    ".": "./src/sap.js",
    "./plugins/*": "./src/plugins/*.js"
  },
  "jsdelivr": "dist/sap.min.js",
  "files": [
    "packed-contract.json",
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "deploy": "wrangler deploy && git rev-parse HEAD > .deploy",
    "build": "node build/bundle.mjs && node scripts/build-doc.mjs && node scripts/build-guide.mjs",
    "build:docs": "node scripts/build-doc.mjs && node scripts/build-guide.mjs",
    "build:guide": "node scripts/build-guide.mjs",
    "propagate": "npm run build && node scripts/propagate.js",
    "copy-to-hyperclayjs": "npm run build && node scripts/propagate.js --only hyperclayjs",
    "copy-to-clayjs": "npm run build && node scripts/propagate.js --only clayjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "serve": "node build/bundle.mjs && python3 -m http.server 8123"
  },
  "keywords": [
    "reactive",
    "html",
    "dom",
    "alpine",
    "hyperclay",
    "html-file-app",
    "no-build"
  ],
  "author": "panphora",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panphora/sapjs.git"
  },
  "homepage": "https://saphtml.com",
  "bugs": {
    "url": "https://github.com/panphora/sapjs/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.21.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "marked": "^18.1.0",
    "numfmt": "4.1.3"
  },
  "peerDependencies": {
    "numfmt": "4.1.3"
  },
  "peerDependenciesMeta": {
    "numfmt": {
      "optional": true
    }
  },
  "hyper": {
    "kind": "lib",
    "status": "active",
    "url": "https://saphtml.com"
  }
}
